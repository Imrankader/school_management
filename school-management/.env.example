# Copy to .env and fill in. Never commit .env.
# Neon JDBC URLs look like: jdbc:postgresql://<host>/<db>?sslmode=require
# Neon: user name and password (same for all 6 databases in the project)
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
AUTH_DB_URL=
STUDENT_DB_URL=
ACADEMIC_DB_URL=
ATTENDANCE_DB_URL=
FEE_DB_URL=
NOTIFICATION_DB_URL=
# DuckDNS domain pointing to the VM, e.g. school-api.duckdns.org
API_DOMAIN=
# Your Vercel frontend URL, e.g. https://school-app.vercel.app
CORS_ALLOWED_ORIGINS=
